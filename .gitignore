# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# WS2 generated runs. Directories stay via .gitkeep.
gpu profling - bottleneck/logs/*
!gpu profling - bottleneck/logs/.gitkeep
gpu profling - bottleneck/.stamps/
gpu profling - bottleneck/reports/ncu/*
!gpu profling - bottleneck/reports/ncu/.gitkeep
gpu profling - bottleneck/reports/nsys/*
!gpu profling - bottleneck/reports/nsys/.gitkeep
gpu profling - bottleneck/tables/*
!gpu profling - bottleneck/tables/.gitkeep

# vLLM evaluation generated runs. Directories stay via .gitkeep.
vllm-evaluation/logs/*
!vllm-evaluation/logs/.gitkeep
vllm-evaluation/.stamps/
vllm-evaluation/results/*
!vllm-evaluation/results/.gitkeep

# Profiler binaries and summaries, wherever they land
*.ncu-rep
*.nsys-rep
*.sqlite
*.qdrep
*.qdstrm
*.kern_sum.csv

# Slurm and pipeline logs
*.log
slurm-*.out
